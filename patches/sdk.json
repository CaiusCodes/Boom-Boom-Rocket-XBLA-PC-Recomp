    {
      "file": "src/ui/window_sdl.cpp",
      "rawSha256": "70FFE182A72DC07AC992C242869F26F9FC4CA9B7439C94509ED17E0493195B96",
      "patchedSha256": "764C2F99AC592D291A43C5DE5D539A147AAD54A581A90BE1D86B4FBF51221F7B",
      "edits": [
        {
          "index": 223,
          "remove": 0,
          "insert": [
            "void WindowSDL::SetLogicalSize(uint32_t logical_width,",
            "                               uint32_t logical_height) {",
            "  if (!sdl_window_ || logical_width == 0 || logical_height == 0) {",
            "    return;",
            "  }",
            "",
            "  // Keep the requested game resolution unchanged.",
            "  OnDesiredLogicalSizeUpdate(logical_width, logical_height);",
            "",
            "  int window_width = int(SizeToPhysical(logical_width));",
            "  int window_height = int(SizeToPhysical(logical_height));",
            "",
            "  // Fullscreen uses the normal selected resolution path.",
            "  if (IsFullscreen()) {",
            "    SDL_SetWindowSize(sdl_window_, window_width, window_height);",
            "    return;",
            "  }",
            "",
            "  // Windowed mode must fit inside the usable desktop including decorations.",
            "  SDL_DisplayID display = SDL_GetDisplayForWindow(sdl_window_);",
            "  if (!display) {",
            "    display = SDL_GetPrimaryDisplay();",
            "  }",
            "",
            "  SDL_Rect usable{};",
            "  if (display && SDL_GetDisplayUsableBounds(display, &usable)) {",
            "    int border_top = 0;",
            "    int border_left = 0;",
            "    int border_bottom = 0;",
            "    int border_right = 0;",
            "",
            "    SDL_GetWindowBordersSize(",
            "        sdl_window_,",
            "        &border_top,",
            "        &border_left,",
            "        &border_bottom,",
            "        &border_right);",
            "",
            "    int max_width =",
            "        usable.w - border_left - border_right;",
            "    int max_height =",
            "        usable.h - border_top - border_bottom;",
            "",
            "    if (max_width > 0 && max_height > 0 &&",
            "        (window_width > max_width || window_height > max_height)) {",
            "      double fit_scale = std::min(",
            "          double(max_width) / double(window_width),",
            "          double(max_height) / double(window_height));",
            "",
            "      window_width =",
            "          std::max(1, int(double(window_width) * fit_scale));",
            "      window_height =",
            "          std::max(1, int(double(window_height) * fit_scale));",
            "    }",
            "  }",
            "",
            "  SDL_SetWindowSize(sdl_window_, window_width, window_height);",
            "  SDL_SyncWindow(sdl_window_);",
            "",
            "  // Always center windowed mode on the display containing the window.",
            "  if (display) {",
            "    SDL_SetWindowPosition(",
            "        sdl_window_,",
            "        SDL_WINDOWPOS_CENTERED_DISPLAY(display),",
            "        SDL_WINDOWPOS_CENTERED_DISPLAY(display));",
            "    SDL_SyncWindow(sdl_window_);",
            "  }",
            "}"
          ]
        },
        {
          "index": 236,
          "remove": 0,
          "insert": [
            ""
          ]
        },
        {
          "index": 237,
