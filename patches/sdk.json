        },
        {
          "index": 241,
          "remove": 0,
          "insert": [
            "  // Feed the overlays actual guest-present FPS rather than host UI FPS.",
            "  {",
            "    auto last_time = std::chrono::steady_clock::now();",
            "    uint64_t last_frame_count = 0;",
            "    double last_fps = 0.0;",
            "",
            "    SetGuestFrameStats(",
            "        [this, last_time, last_frame_count, last_fps]() mutable {",
            "          ui::FrameStats stats;",
            "",
            "          if (!runtime_) {",
            "            return stats;",
            "          }",
            "",
            "          auto* graphics_system = runtime_->graphics_system();",
            "          if (!graphics_system) {",
            "            return stats;",
            "          }",
            "",
            "          const uint64_t frame_count =",
            "              graphics_system->guest_frame_count();",
            "          const auto now = std::chrono::steady_clock::now();",
            "",
            "          if (last_frame_count == 0) {",
            "            last_frame_count = frame_count;",
            "            last_time = now;",
            "          }",
            "",
            "          const double elapsed_seconds =",
            "              std::chrono::duration<double>(now - last_time).count();",
            "",
            "          if (elapsed_seconds >= 0.25) {",
            "            const uint64_t frame_delta =",
            "                frame_count - last_frame_count;",
            "",
            "            last_fps =",
            "                static_cast<double>(frame_delta) / elapsed_seconds;",
            "",
            "            last_frame_count = frame_count;",
            "            last_time = now;",
            "          }",
            "",
            "          stats.frame_count = frame_count;",
            "          stats.fps = last_fps;",
            "          stats.frame_time_ms =",
            "              last_fps > 0.0 ? 1000.0 / last_fps : 0.0;",
            "",
            "          return stats;",
            "        });",
            "  }",
            ""
          ]
        },
        {
          "index": 253,
          "remove": 0,
          "insert": [
            "        // A modal ImGui popup (BeginPopupModal) is exclusive by definition -",
            "        // block guest input unconditionally while one is open, regardless of",
            "        // mouse position. This covers app-added dialogs the base ReXApp has",
            "        // no member flag for (e.g. a title's own settings dialog), not just",
            "        // the four named overlays below. Queried via a plain atomic snapshot",
            "        // (not live ImGui state) because this callback runs on whichever",
            "        // guest thread calls XamInputGetState, concurrently with the UI",
            "        // thread's own ImGui frame - ImGui's context isn't thread-safe.",
