        {
          "index": 350,
          "remove": 0,
          "insert": [
            "bool GraphicsSystem::ReinitializeContext() {",
            "  if (!command_processor_) {",
            "    return false;",
            "  }",
            "",
            "  rex::thread::Fence fence;",
            "  bool success = false;",
            "",
            "  command_processor_->CallInThread([&] {",
            "    success = command_processor_->ReinitializeContext();",
            "    fence.Signal();",
            "  });",
            "",
            "  fence.Wait();",
            "  return success;",
            "}"
